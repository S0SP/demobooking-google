# ─── Public Environment Variables (Browser-accessible) ───────────────────

# The canonical base URL of your site (e.g. https://unboundyou.com)
NEXT_PUBLIC_SITE_URL=https://demo.unboundyou.com

# Google Tag Manager Container ID (e.g. GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Microsoft Clarity Project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Facebook Pixel ID
NEXT_PUBLIC_FB_PIXEL_ID=

# Firebase Client SDK Configuration (must correspond to Firestore rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=


# ─── Private Environment Variables (Server-side only) ──────────────────────

# Razorpay Checkout credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email settings for booking confirmations (Gmail SMTP)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here
TEAM_EMAIL=team_bookings@yourdomain.com

# Firebase Admin SDK Configuration (Option A: Base64 JSON)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase Admin SDK Configuration (Option B: Individual fields, used if option A is empty)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
