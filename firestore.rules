rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // All writes happen via Admin SDK (server-side) — rules only govern client reads.

    match /bookings/{bookingId} {
      // Thank-you page reads its own booking doc
      allow get:                  if true;
      allow list, create, update,
            delete:               if false;
    }

    match /phoneIndex/{phoneId} {
      allow get:                  if true;  // duplicate pre-check
      allow list, create, update,
            delete:               if false; // server-only writes
    }

    match /emailIndex/{emailId} {
      allow get:                  if true;  // duplicate pre-check
      allow list, create, update,
            delete:               if false; // server-only writes
    }
  }
}
